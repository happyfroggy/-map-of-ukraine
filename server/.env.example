PORT=3000
# Required when NODE_ENV=production
ADMIN_PASSWORD=change-me
# Secret for signing admin tokens. If empty, a random one is generated on each start.
TOKEN_SECRET=
# Production: Postgres connection string (e.g. Neon). Empty → embedded PGlite in DATABASE_PATH.
DATABASE_URL=
DATABASE_PATH=data/pglite
# Comma-separated list of allowed browser origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173
# Base URL encoded in the QR code. Use your LAN IP so phones can reach it, e.g. http://192.168.1.20:5173
PUBLIC_URL=http://localhost:5173
